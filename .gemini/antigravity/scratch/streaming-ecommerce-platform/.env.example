# ==============================================================================
# Streaming E-Commerce Platform Environment Configuration
# ==============================================================================

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:29092
KAFKA_TOPIC_ORDERS=ecommerce.orders
KAFKA_TOPIC_CLICKSTREAM=ecommerce.clickstream
KAFKA_TOPIC_PAYMENTS=ecommerce.payments
KAFKA_TOPIC_CUSTOMERS=ecommerce.customers

# MinIO (S3-Compatible Data Lake) Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ENDPOINT_DOCKER=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ecommerce-lake
AWS_REGION=us-east-1

# Lakehouse Storage Prefixes
LAKE_BRONZE_PREFIX=s3a://ecommerce-lake/bronze
LAKE_SILVER_PREFIX=s3a://ecommerce-lake/silver
LAKE_GOLD_PREFIX=s3a://ecommerce-lake/gold
CHECKPOINT_PREFIX=s3a://ecommerce-lake/checkpoints

# PostgreSQL Data Warehouse Configuration
POSTGRES_HOST=localhost
POSTGRES_HOST_DOCKER=postgres-dw
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_dw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SCHEMA=warehouse

# Snowflake Data Warehouse Configuration (Optional alternative to PostgreSQL)
SNOWFLAKE_ACCOUNT=your_snowflake_account
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_DATABASE=ECOMMERCE_DW
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=MARTS

# Apache Spark Configuration
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_LOCAL_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Apache Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Event Producer Configuration
PRODUCER_EMIT_RATE_HZ=5
PRODUCER_SEED=42
SIMULATION_MAX_CUSTOMERS=500
SIMULATION_MAX_PRODUCTS=100
