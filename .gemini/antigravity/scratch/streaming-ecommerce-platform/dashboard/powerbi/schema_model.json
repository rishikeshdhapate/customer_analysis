{
  "name": "EcommerceStarSchemaModel",
  "version": "1.0",
  "tables": [
    {
      "name": "fct_orders",
      "type": "Fact",
      "columns": ["order_id", "customer_key", "product_key", "date_key", "quantity", "revenue", "order_status", "order_timestamp"]
    },
    {
      "name": "fct_clickstream",
      "type": "Fact",
      "columns": ["event_id", "customer_key", "product_key", "date_key", "event_type", "session_id", "device", "referrer", "event_timestamp"]
    },
    {
      "name": "dim_customers",
      "type": "Dimension",
      "columns": ["customer_key", "customer_id", "name", "email", "city", "state", "country", "signup_date"]
    },
    {
      "name": "dim_products",
      "type": "Dimension",
      "columns": ["product_key", "product_id", "name", "category", "price", "stock"]
    },
    {
