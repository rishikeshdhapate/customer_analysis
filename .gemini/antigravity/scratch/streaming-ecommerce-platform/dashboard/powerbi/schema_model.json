    },
    {
      "fromTable": "fct_orders",
      "fromColumn": "date_key",
      "toTable": "dim_date",
      "toColumn": "date_key",
      "cardinality": "ManyToOne",
      "crossFilteringBehavior": "OneDirection"
    },
    {
