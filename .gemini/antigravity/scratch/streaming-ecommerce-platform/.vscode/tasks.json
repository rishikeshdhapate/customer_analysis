{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Local Pipeline Demo",
      "type": "shell",
      "command": "python scripts/run_local_demo.py",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Launch Streamlit Dashboard",
      "type": "shell",
      "command": "streamlit run dashboard/app.py",
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Tests with Pytest",
      "type": "shell",
      "command": "pytest tests/ -v",
      "group": "test",
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Start All Services (Compose Up)",
      "type": "shell",
      "command": "docker compose up -d --build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Stop All Services (Compose Down)",
      "type": "shell",
      "command": "docker compose down",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
